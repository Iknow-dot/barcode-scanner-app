# Read by `npm run build` only (never by `npm start` or jest).
#
# No source maps in production bundles: with them, anyone who opens DevTools
# gets the original, commented source tree of the frontend.
GENERATE_SOURCEMAP=false

# Content-Security-Policy for public/index.html. Scripts only: the tokens in
# localStorage are what an injected script would steal. Network, images, styles
# and fonts stay unrestricted, because the API origin and the PostHog/Sentry
# hosts differ per install. https://*.posthog.com serves PostHog's lazily
# loaded scripts (recorder, remote config). Printed invoices open as blob pages
# that inherit this policy, so their Print button is wired by
# src/utils/invoicePrintButton.js, never inline.
REACT_APP_CONTENT_SECURITY_POLICY=script-src 'self' https://*.posthog.com; object-src 'none'; base-uri 'self'; upgrade-insecure-requests
