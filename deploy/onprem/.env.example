# Copy to .env and fill in. Keep .env out of version control and backed up:
# losing FERNET_KEY makes every stored 1C web-service password unreadable.
#
# Use hex for generated secrets (commands below). Compose interpolates "$" in
# this file, and POSTGRES_PASSWORD is embedded in a database URL, so symbols in
# either place break start-up.

# --- Release -----------------------------------------------------------------
# Pin exact versions. Upgrading = changing both tags, then `docker compose pull`
# and `docker compose up -d` (migrations run automatically on start).
BACKEND_IMAGE=registry.example.com/iflow/iflow-backend:1.0.0
FRONTEND_IMAGE=registry.example.com/iflow/iflow-frontend:1.0.0

# --- Site ----------------------------------------------------------------------
# The hostname users type, without scheme or port.
PUBLIC_HOSTNAME=scanner.example.ge
# Host port the app listens on; point your HTTPS reverse proxy at it.
HTTP_PORT=8080
# IP or CIDR of that HTTPS reverse proxy (comma-separated for several). Needed
# for per-user IP allowlists to see real client addresses.
TRUSTED_PROXY_CIDR=
# Only for a first smoke test over plain HTTP. Leave True in production.
SECURE_SSL_REDIRECT=True

# --- Secrets -------------------------------------------------------------------
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 50
DJANGO_SECRET_KEY=
# openssl rand -base64 32 | tr '+/' '-_'
FERNET_KEY=

# --- Optional monitoring (blank = off) ---------------------------------------------
SENTRY_DSN=
REACT_APP_SENTRY_DSN=
SENTRY_ENVIRONMENT=onprem
SENTRY_TRACES_SAMPLE_RATE=
REACT_APP_PUBLIC_POSTHOG_KEY=
REACT_APP_PUBLIC_POSTHOG_HOST=
POSTHOG_DASHBOARD_URL=

# --- Other -----------------------------------------------------------------------
LOG_LEVEL=INFO
# Identifying User-Agent for the Photon geocoder, e.g. "iflow/1.0 (it@example.ge)".
PHOTON_USER_AGENT=
